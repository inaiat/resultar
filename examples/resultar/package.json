{
  "name": "resultar-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../../packages/check/dist/cli.js",
    "prepare": "pnpm --filter resultar build && pnpm --filter resultar-check build",
    "smoke": "pnpm run prepare && pnpm run check && tsx scripts/smoke.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "resultar": "workspace:*",
    "resultar-check": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "7.0.2"
  }
}
