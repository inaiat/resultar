{
  "name": "resultar-check-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "resultar-check --project tsconfig.json",
    "check:clean": "resultar-check --project tsconfig.clean.json",
    "check:json": "resultar-check --project tsconfig.json --json",
    "prepare": "pnpm --filter resultar build && pnpm --filter resultar-check build && pnpm --filter resultar-check native:build:current",
    "smoke": "pnpm run prepare && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "resultar": "workspace:*",
    "resultar-check": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:"
  }
}
