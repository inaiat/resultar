{
  "name": "resultar-ls-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run lint:resultar",
    "lint:resultar": "resultar-no-discard --project tsconfig.json",
    "prepare": "pnpm --filter resultar build && pnpm --filter resultar-ls build && resultar-ls patch",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "resultar": "workspace:*"
  },
  "devDependencies": {
    "resultar-ls": "workspace:*",
    "tsx": "catalog:",
    "typescript": "^6.0.3"
  }
}
