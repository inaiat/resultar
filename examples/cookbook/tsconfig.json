{
  "$schema": "./node_modules/resultar-check/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "resultar-check",
        "failOn": "message",
        "noAwaitInSafeTry": "error",
        "noAwaitInResultTaskGen": "error",
        "noDiscard": "error",
        "noDiscardMode": "must-use",
        "noFnIife": "error",
        "noInvalidLifetime": "error",
        "noPromiseInResultSuccess": "error",
        "noResultInTaskGen": "error",
        "noRunInsideGen": "error",
        "noTaggedErrorConstructorOverride": "error",
        "noThrow": "error",
        "noThrowInTaskSync": "error",
        "noTryCatch": "error",
        "noTryCatchInSafeTry": "error",
        "noUnknownResultError": "error",
        "noUnknownTaskRequirements": "error",
        "noUnnecessaryErrWrapInGen": "error",
        "noUnsafeAwait": "error",
        "noUnsafeAwaitMode": "resultar-context",
        "noUnscopedAcquireRelease": "error",
        "noUselessRecovery": "error",
        "preferAcquireDisposable": "error",
        "preferAndThen": "error",
        "preferAsVoid": "error",
        "preferCatchReason": "error",
        "preferFilterOrElse": "error",
        "preferFirstSuccessOf": "error",
        "preferMap": "error",
        "preferMapErr": "error",
        "preferOrElseSucceed": "error",
        "preferResultForEach": "error",
        "preferTaggedError": "error",
        "preferTap": "error",
        "preferTapError": "error",
        "requireReturnYieldStar": "error",
        "taggedErrorNameMatch": "error",
        "typedCatchMapper": "error",
        "unnecessaryPipe": "error",
        "unsafeResultTypeAssertion": "error",
        "unusedSuppression": "error",
        "yieldStarInResultTaskGen": "error",
        "yieldStarInSafeTry": "error"
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
