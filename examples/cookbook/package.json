{
  "name": "resultar-cookbook-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../../packages/check/dist/cli.js --project tsconfig.json",
    "check:resultar": "node ../../packages/check/dist/cli.js --project tsconfig.json",
    "check:fix": "node ../../packages/check/dist/cli.js --project tsconfig.json --fix",
    "check:json": "node ../../packages/check/dist/cli.js --project tsconfig.json --json",
    "check:types": "tsc --project tsconfig.json",
    "build:deps": "pnpm --filter resultar build && pnpm --filter resultar-check build && pnpm --filter resultar-check native:build:current",
    "smoke": "pnpm run build:deps && pnpm run check:types && pnpm run check && tsx scripts/smoke.ts && tsx scripts/lifecycle-smoke.ts",
    "start": "pnpm run build:deps && tsx src/index.ts"
  },
  "dependencies": {
    "resultar": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "resultar-check": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
