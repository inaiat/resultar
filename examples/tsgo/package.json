{
  "name": "resultar-tsgo-example",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run lint:resultar",
    "lint": "pnpm run lint:resultar",
    "lint:resultar": "tsgo -p tsconfig.json --noEmit",
    "prepare": "pnpm --filter resultar build && pnpm --filter resultar-ls build && pnpm --filter resultar-tsgo build",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "resultar": "workspace:*",
    "resultar-tsgo": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "resultar-ls": "workspace:*",
    "tsx": "catalog:"
  }
}
