{
  "name": "resultar-workspace",
  "private": true,
  "scripts": {
    "analyze": "pnpm -r --filter './packages/*' run analyze",
    "build": "pnpm -r --filter './packages/*' run build",
    "changeset": "changeset",
    "check": "pnpm -r --filter './packages/*' run check",
    "check:full": "pnpm -r --filter './packages/*' run check:full",
    "example:resultar": "pnpm --filter resultar-example smoke",
    "example:lint": "pnpm --filter resultar-lint-example smoke",
    "example:language-service": "pnpm run example:lint",
    "example:vite-plus": "pnpm --filter resultar-lint-example smoke:vite",
    "example:tsgo-lint": "pnpm --filter resultar-tsgo-lint-example smoke",
    "example:tsgo": "pnpm run example:tsgo-lint",
    "fmt": "pnpm -r --filter './packages/*' run fmt",
    "fmt:check": "pnpm -r --filter './packages/*' run fmt:check",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "lint:fix": "pnpm -r --filter './packages/*' run lint:fix",
    "release:jsr": "node scripts/publish-jsr.mjs",
    "release:npm": "node scripts/publish-npm.mjs",
    "smoke:package": "pnpm -r --filter './packages/*' run smoke:package",
    "sync:jsr-version": "node scripts/sync-jsr-versions.mjs && vp fmt packages/resultar/jsr.json packages/resultar-lint/jsr.json packages/resultar-tsgo/jsr.json",
    "test:examples": "pnpm run example:resultar && pnpm run example:lint && pnpm run example:vite-plus && pnpm run example:tsgo-lint",
    "test:language-service": "pnpm run example:lint && pnpm run example:vite-plus && pnpm run example:tsgo-lint",
    "test": "pnpm -r --filter './packages/*' run test",
    "test:watch": "pnpm -r --filter './packages/*' run test:watch",
    "test:ui": "pnpm -r --filter './packages/*' run test:ui",
    "test:cov": "pnpm -r --filter './packages/*' run test:cov",
    "bench": "pnpm --filter resultar-benchmarks bench",
    "bench:neverthrow": "pnpm --filter resultar-benchmarks bench:neverthrow",
    "version:packages": "changeset version && pnpm run sync:jsr-version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "packageManager": "pnpm@11.5.1"
}
