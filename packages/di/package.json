{
  "name": "resultar-di",
  "version": "0.4.0",
  "description": "Typed dependency composition and scoped resources for ResultTask.",
  "keywords": [
    "composition",
    "dependency-injection",
    "resources",
    "resultar",
    "resulttask"
  ],
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/di"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "analyze": "fallow",
    "build": "vp pack && node --import tsx scripts/declaration-imports.ts",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check && pnpm run test:cov",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepare": "vp config || true",
    "prepublishOnly": "pnpm run build",
    "smoke:package": "pnpm run build && node --import tsx scripts/smoke-package.ts",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:ui": "vp test --ui --watch",
    "test:cov": "vp test run --coverage",
    "test:dx": "pnpm run build && node --import tsx scripts/diagnostics.ts",
    "test:scale": "pnpm run build && node --import tsx scripts/scale-types.ts"
  },
  "dependencies": {
    "resultar": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
