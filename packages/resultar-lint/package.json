{
  "name": "resultar-lint",
  "version": "3.0.0",
  "description": "Lint and build-time diagnostics for Resultar",
  "keywords": [
    "lint",
    "no-discard",
    "resultar",
    "typescript"
  ],
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/resultar-lint"
  },
  "bin": {
    "resultar-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint-plugin.d.ts",
      "import": "./dist/oxlint-plugin.js",
      "require": "./dist/oxlint-plugin.cjs",
      "default": "./dist/oxlint-plugin.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check && pnpm run test:cov",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config || true",
    "prepublishOnly": "vp pack",
    "smoke:package": "pnpm run build && tsx scripts/smoke-package.ts",
    "test": "pnpm run build && vp test run",
    "test:cov": "pnpm run build && vp test run --coverage",
    "test:ui": "pnpm run build && vp test --ui --watch",
    "test:watch": "pnpm run build && vp test watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
