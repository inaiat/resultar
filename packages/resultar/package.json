{
  "name": "resultar",
  "version": "3.3.0",
  "description": "Result pattern for TypeScript",
  "keywords": [
    "error-handling",
    "functional-programming",
    "result",
    "result-pattern",
    "resultasync",
    "tagged-errors",
    "typescript"
  ],
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "contributors": [
    "Inaiat <inaiat@gmail.com>",
    "Tomaz Haidar <tomaz_haidar@hotmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/resultar"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "analyze": "fallow",
    "build": "vp pack",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check && vp test run --coverage",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepublishOnly": "vp pack",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:ui": "vp test --ui --watch",
    "test:cov": "vp test run --coverage",
    "test:mutation": "stryker run",
    "prepare": "vp config || true",
    "smoke:package": "pnpm run build && tsx scripts/smoke-package.ts",
    "sync:jsr-version": "node scripts/sync-jsr-version.mjs && vp fmt jsr.json",
    "bench": "pnpm --filter resultar-benchmarks bench",
    "bench:neverthrow": "pnpm --filter resultar-benchmarks bench:neverthrow"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ]
}
