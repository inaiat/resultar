{
  "name": "resultar",
  "version": "5.0.0-beta.2",
  "description": "Typed error handling, lazy ResultTask workflows, structured concurrency, and opt-in observability for TypeScript.",
  "keywords": [
    "error-handling",
    "functional-programming",
    "result",
    "result-pattern",
    "result-task",
    "structured-concurrency",
    "tagged-errors",
    "typescript"
  ],
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "contributors": [
    "Inaiat <inaiat@gmail.com>",
    "Tomaz Haidar <tomaz_haidar@hotmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/resultar"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js"
    },
    "./task": {
      "types": "./dist/task.d.ts",
      "import": "./dist/task.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./tagged": {
      "types": "./dist/tagged.d.ts",
      "import": "./dist/tagged.js"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "import": "./dist/function.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js"
    }
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/build-agent-guide.mjs",
    "check": "vp check",
    "check:fallow": "fallow",
    "check:full": "pnpm run build && pnpm run check && vp test run --coverage",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepublishOnly": "pnpm run build",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:ui": "vp test --ui --watch",
    "test:cov": "vp test run --coverage",
    "test:mutation": "stryker run",
    "prepare": "vp config || true",
    "smoke:package": "pnpm run build && vpx scripts/smoke-package.ts",
    "sync:jsr-version": "node scripts/sync-jsr-version.mjs && vp fmt jsr.json",
    "bench": "pnpm --filter resultar-benchmarks bench",
    "bench:neverthrow": "pnpm --filter resultar-benchmarks bench:neverthrow",
    "bench:task": "pnpm --filter resultar-benchmarks run bench:task"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ]
}
