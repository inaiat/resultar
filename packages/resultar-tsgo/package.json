{
  "name": "resultar-tsgo",
  "version": "3.1.0-beta.1",
  "description": "Resultar no-discard wrapper for the TypeScript 7 native preview tsgo binary",
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/resultar-tsgo"
  },
  "bin": {
    "tsgo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config || true",
    "prepublishOnly": "vp pack",
    "smoke": "pnpm run smoke:package",
    "smoke:package": "pnpm run build && tsx scripts/smoke-package.ts"
  },
  "dependencies": {
    "resultar-lint": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tsx": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@typescript/native-preview": ">=7"
  },
  "engines": {
    "node": ">=24"
  }
}
