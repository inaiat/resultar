{
  "name": "resultar-tsgo",
  "version": "3.1.0",
  "description": "Deprecated compatibility wrapper for resultar-check",
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/resultar-tsgo"
  },
  "bin": {
    "resultar-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config || true",
    "prepublishOnly": "vp pack",
    "smoke": "pnpm run smoke:package",
    "smoke:package": "pnpm --filter resultar-check build && pnpm run build && tsx scripts/smoke-package.ts"
  },
  "dependencies": {
    "resultar-check": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "deprecated": "Use resultar-check. This package is a compatibility wrapper."
}
