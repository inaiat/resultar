{
  "name": "resultar-tsgo",
  "version": "3.0.0-alpha.1",
  "description": "Resultar no-discard wrapper for the TypeScript 7 native preview tsgo binary",
  "license": "MIT",
  "bin": {
    "tsgo": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "vp check",
    "smoke": "pnpm run build && node dist/cli.js --version"
  },
  "dependencies": {
    "resultar-ls": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@typescript/native-preview": ">=7"
  },
  "engines": {
    "node": ">=24"
  }
}
