{
  "name": "resultar-check",
  "version": "2.2.2",
  "description": "Native Resultar diagnostics powered by TypeScript-Go",
  "keywords": [
    "diagnostics",
    "go",
    "native",
    "no-discard",
    "resultar",
    "typescript"
  ],
  "homepage": "https://github.com/inaiat/resultar",
  "bugs": {
    "url": "https://github.com/inaiat/resultar/issues"
  },
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inaiat/resultar.git",
    "directory": "packages/check"
  },
  "bin": {
    "resultar-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "schema.json"
  ],
  "type": "module",
  "exports": {
    "./schema.json": "./schema.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:full": "pnpm run build && pnpm run check && pnpm run native:test && pnpm run native:check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "native:build": "go -C native build -o resultar-check-native ./cmd/resultar-check",
    "native:build:all": "node scripts/build-native-binaries.ts --all",
    "native:build:current": "node scripts/build-native-binaries.ts --current",
    "native:check": "go -C native run ./cmd/resultar-check --project ../tsconfig.json",
    "native:fmt": "gofmt -w native/cmd native/internal",
    "test": "pnpm run native:test",
    "native:test": "go -C native test ./...",
    "prepare": "vp config || true",
    "prepublishOnly": "vp pack",
    "smoke:package": "pnpm run build && pnpm run native:build:current && tsx scripts/smoke-package.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "resultar-check-darwin-arm64": "workspace:*",
    "resultar-check-darwin-x64": "workspace:*",
    "resultar-check-linux-arm64": "workspace:*",
    "resultar-check-linux-x64": "workspace:*",
    "resultar-check-win32-arm64": "workspace:*",
    "resultar-check-win32-x64": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
